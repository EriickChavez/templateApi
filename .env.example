# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Información de la API
API_VERSION=v1

# ===== CONFIGURACIÓN DE BASE DE DATOS =====
# El sistema de inyección de dependencias detectará automáticamente el tipo de BD
# basado en la DATABASE_URL. Elegir UNA de las siguientes opciones:

# OPCIÓN 1: MongoDB (local)
# DATABASE_URL=mongodb://localhost:27017/templateapi

# OPCIÓN 1b: MongoDB Atlas (producción)
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/templateapi

# OPCIÓN 2: MySQL (local)
# DATABASE_URL=mysql://root:password@localhost:3306/templateapi

# OPCIÓN 2b: MySQL (producción con SSL)
# DATABASE_URL=mysql://username:password@host:3306/templateapi?ssl=true

# OPCIÓN 3: Variables individuales para MySQL (alternativa)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=tu_password
# MYSQL_DATABASE=templateapi
# MYSQL_SSL=false

# OPCIÓN 4: Variables individuales para MongoDB (alternativa)
# MONGODB_URI=mongodb://localhost:27017/templateapi
# MONGODB_DATABASE=templateapi

# OPCIÓN 5: Sin base de datos (usa repositorio en memoria)
# DATABASE_URL=

# Autenticación
JWT_SECRET=tu-super-secreto-jwt-aqui-muy-largo-y-seguro-minimo-32-caracteres
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# CORS
CORS_ORIGIN=*

# Logs
LOG_LEVEL=info

# Elasticsearch (opcional - para búsqueda avanzada)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_AUTH=true
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme
# ELASTICSEARCH_SSL=false

# Otras configuraciones
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=tu@email.com
# EMAIL_PASS=tu-password

# APIs Externas (ejemplo)
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_test_...
