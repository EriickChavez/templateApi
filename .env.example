# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Información de la API
API_VERSION=v1

# Base de Datos (opcional)
# DATABASE_URL=mongodb://localhost:27017/templateapi
# DATABASE_URL=postgresql://user:password@localhost:5432/templateapi

# Autenticación
JWT_SECRET=tu-super-secreto-jwt-aqui-muy-largo-y-seguro-minimo-32-caracteres
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# CORS
CORS_ORIGIN=*

# Logs
LOG_LEVEL=info

# Otras configuraciones
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=tu@email.com
# EMAIL_PASS=tu-password

# APIs Externas (ejemplo)
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_test_...
