  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Configurar variables base si no existen",
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost:3000');",
          "}",
          "",
          "// Log para debugging",
          "console.log('Base URL:', pm.environment.get('baseUrl'));",
          "console.log('Token:', pm.environment.get('token') ? 'Configurado' : 'No configurado');"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Log de respuesta para debugging",
          "console.log('Status:', pm.response.code);",
          "console.log('Response:', pm.response.text());"
        ],
        "type": "text/javascript"
      }
    }
